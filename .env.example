# Site
NEXT_PUBLIC_SITE_URL=https://analytics.signalstudio.ie

# ─────────────────────────────────────────────────────────────
# Clerk · authentication
# Create the application at https://dashboard.clerk.com.
# /app/* routes require sign-in; /u/[token] + /api/unsubscribe/* are public.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─────────────────────────────────────────────────────────────
# Turso · libSQL database (Analytics-owned, for user preferences)
# Create with: turso db create signal-analytics
# Get URL:    turso db show signal-analytics --url
# Get token:  turso db tokens create signal-analytics
# Mark BOTH env vars as Sensitive in Vercel.
# ─────────────────────────────────────────────────────────────
TURSO_ANALYTICS_DATABASE_URL=
TURSO_ANALYTICS_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────
# Resend · email delivery
# Get a key at https://resend.com/api-keys
# RESEND_FROM uses the verified signalstudio.ie domain (DKIM owed).
# If RESEND_API_KEY is unset, dispatch fails gracefully ("skipped: no-resend-key")
# instead of throwing — keeps local dev usable without an account.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Signal Analytics <hello@signalstudio.ie>

# ─────────────────────────────────────────────────────────────
# Cron · daily/weekly briefing fanout
# Generate with: openssl rand -hex 32
# Required for /api/cron/briefings (without it, the endpoint 401s
# every request — including Vercel's own cron).
# ─────────────────────────────────────────────────────────────
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Tasks DB · read-only cross-product token
# The Analytics briefing engine reads Tasks data via a read-only
# Turso token. NEVER use a read-write token here.
# Get read-only token: turso db tokens create signal-tasks --read-only
# Mark BOTH as Sensitive in Vercel.
# ─────────────────────────────────────────────────────────────
TASKS_DATABASE_URL=
TASKS_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────
# Entitlements DB · shared cross-suite tier enforcement
# Read-only from Analytics. Provisioned in E-1 (2026-05-14).
# Mark BOTH as Sensitive in Vercel.
# ─────────────────────────────────────────────────────────────
TURSO_ENTITLEMENTS_DATABASE_URL=
TURSO_ENTITLEMENTS_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────
# Studio HQ ping · cron observability
# Fires a POST to Studio's /api/cron/status after each run.
# STUDIO_CRON_PING_URL must be an https://signalstudio.ie host —
# the code validates this before sending the secret.
# ─────────────────────────────────────────────────────────────
STUDIO_CRON_PING_URL=
STUDIO_CRON_PING_SECRET=

# ─────────────────────────────────────────────────────────────
# Sentry · error tracking (optional)
# When DSN is unset the SDK no-ops — the app boots without Sentry.
# Server-side ingest (instrumentation.ts) — captures cron failures too:
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Browser ingest (instrumentation-client.ts) — must be NEXT_PUBLIC_*:
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
